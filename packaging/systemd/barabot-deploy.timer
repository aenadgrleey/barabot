# Checks the prod branch every minute; a push to prod is live within about a minute.
#   systemctl list-timers barabot-deploy           when it runs next
#   systemctl disable --now barabot-deploy.timer   turn auto-deploy off
[Unit]
Description=barabot: check the prod branch every minute

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
