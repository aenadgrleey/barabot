# Sample systemd unit. Adjust User=, WorkingDirectory=, and the .env path.
#
# Install:
#   sudo cp deploy/barabot.service /etc/systemd/system/barabot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now barabot.service
#
# Inspect:
#   systemctl status barabot
#   journalctl -u barabot -f
#
# The barabot user needs read access to the .env file and write access
# to the project directory (data/ for the SQLite DB and lock file).

[Unit]
Description=barabot — Telegram userbot that logs novel chat content
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andrey
WorkingDirectory=/root/projects/barabot
ExecStartPre=/root/projects/barabot/.venv/bin/python -m barabot --check
ExecStart=/root/projects/barabot/.venv/bin/python -m barabot
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Hardening — adjust to taste.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/projects/barabot/data
# .env lives in the project root; ProtectHome=read-only allows reading it.

[Install]
WantedBy=multi-user.target
