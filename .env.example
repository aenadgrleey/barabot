# Get these from https://my.telegram.org (NOT the bot token page — API ID/hash)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Session string: generate with `python -m barabot.session_gen`
# Store it here after first run, then never touch it again.
SESSION_STRING=

# OpenAI-compatible embeddings. Default points at OpenAI; swap to any
# provider that implements POST /v1/embeddings (Together, LM Studio, etc.)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_URL=https://api.openai.com/v1/embeddings
# Cosine similarity threshold. Below this, the message is considered "new".
# 0.85 is a decent starting point for paraphrased duplicates.
SIMILARITY_THRESHOLD=0.85

# Comma-separated chat IDs to watch. -100 prefix for groups/channels.
# Negative for groups, positive for users/bots.
WATCH_CHATS=

# How loud the bot's own logger is. DEBUG/INFO/WARNING/ERROR/CRITICAL.
# pyrogram is forced to WARNING regardless.
LOG_LEVEL=INFO

# Max parallel embedding calls. Tune to your rate limit budget.
EMBEDDING_CONCURRENCY=4
# Retries on 5xx and network errors. 4xx (other than 429) fails immediately.
EMBEDDING_RETRIES=3
# Per-request HTTP timeout in seconds.
EMBEDDING_TIMEOUT=30

# --- Reporter bot (optional) -----------------------------------------------
# Get from @BotFather. This is the *bot* token, NOT the SESSION_STRING above.
REPORTER_BOT_TOKEN=

# Who can talk to the reporter and where 'NEW' notifications get pushed.
# Comma-separated chat IDs. Empty = reporter is inert (commands disabled).
ALLOWED_CHAT_IDS=

# How often (seconds) the reporter polls the SQLite db for new rows.
# 2.0 is a good balance; lower if you want fresher pings, higher to save CPU.
REPORTER_POLL_INTERVAL=2.0

# /latest default page size. Max 100.
REPORTER_DEFAULT_LIMIT=10
