# Copy this file to config/.env. config/ is machine-local and ignored by Git.
# Required deployment mode: exactly "develop" or "prod".
BARABOT_ENV=develop

# tgmux uses the gateway when importable. telethon always uses the local session.
TELEGRAM_BACKEND=tgmux

# Comma-separated chat IDs to watch. -100 prefix for groups/channels.
# Negative for groups, positive for users/bots.
WATCH_CHATS=

# On startup, re-read this many hours of history from every watched chat.
BACKFILL_HOURS=24

# Hard limit on TypeSafe Jev spend in USD; empty = no limit. Spend is counted
# from recorded input tokens times JEV_PRICE_PER_M_INPUT.
JEV_BUDGET_USD=
JEV_PRICE_PER_M_INPUT=0.042

# Digest of processing at NOTICE level every N minutes; 0 turns it off.
STATS_INTERVAL_MINUTES=60

# How loud the bot's own logger is. DEBUG/INFO/WARNING/ERROR/CRITICAL.
# pyrogram is forced to WARNING regardless.
LOG_LEVEL=INFO

# --- Telegram bot ----------------------------------------------------------
# Verify and save the BotFather token outside this env file with:
#   .venv/bin/python -m barabot bot auth <token>
# The raw token is stored privately in config/bot.token.

# Who can talk to the reporter and where 'NEW' notifications get pushed.
# Comma-separated chat IDs. Empty = reporter is inert (commands disabled).
ALLOWED_CHAT_IDS=

# How often (seconds) the reporter polls the SQLite db for new rows.
# 2.0 is a good balance; lower if you want fresher pings, higher to save CPU.
REPORTER_POLL_INTERVAL=2.0

# /latest default page size. Max 100.
REPORTER_DEFAULT_LIMIT=10

# --- Headless setup input --------------------------------------------------
# These are input variable names for `python -m barabot setup --headless`.
# Keep real values in a secret store; do not add them to this public template.
# Always required: the bot connects with them, standalone Telethon uses them too.
# Setup writes them to config/telegram.env.
# API_ID=
# API_HASH=
# TYPESAFE_API_KEY=
# BOT_TOKEN=
